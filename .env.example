# Copy this file to .env for local development.
# Environment variables exported by your shell still take precedence.

OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-5.5

# Optional local durable chat runtime. See services/pi-intelligence/README.md.
AI_BACKEND=openai
PI_URL=http://127.0.0.1:4100
# GPT-5.5 shop chat defaults to off (Responses reasoning effort none).
# Set low if your catalog evaluations need more reasoning.
PI_THINKING_LEVEL=off
# Generate with: openssl rand -hex 32. Share only with Phoenix and the Pi service.
PI_SERVICE_TOKEN=
SOKOCHAT_INTERNAL_URL=http://127.0.0.1:4000

# WhatsApp Cloud API.
# Per-workspace credentials (Phone Number ID, WABA ID, Access Token) are set in
# the dashboard at /workspaces/:id/meta, not here. Only the global Graph API
# version is read from the environment (optional; defaults to v21.0).
WHATSAPP_GRAPH_API_VERSION=v21.0
# Required for authenticated webhook POSTs in production. Get it from the Meta app.
META_APP_SECRET=

# Required for the webhook callback URL shown on the Meta Connection screen.
# In production this must be your public HTTPS hostname.
PHX_HOST=localhost
