<!DOCTYPE html>
<html lang="en" data-marketing={assigns[:marketing]}>
  <head>
    <script>
      (function () {
        try {
          var root = document.documentElement
          if (root.hasAttribute("data-marketing")) return
          var choice = localStorage.getItem("soko-appearance") || "system"
          var dark = choice === "dark" ||
            (choice === "system" && matchMedia("(prefers-color-scheme: dark)").matches)
          if (dark) root.setAttribute("data-theme", "dark")
        } catch (e) {}
      })()
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="AI answers customers from your catalogue on WhatsApp, automatically or after you approve each reply. Orders and questions wait on your desk."
    />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0a5e44" />
    <link rel="canonical" href={~p"/"} />
    <link rel="icon" type="image/png" href={~p"/images/logobg.png"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sokochat" />
    <meta property="og:title" content="Sokochat · Turn WhatsApp chats into orders" />
    <meta
      property="og:description"
      content="AI answers customers from your catalogue on WhatsApp, automatically or after you approve each reply. Orders and questions wait on your desk."
    />
    <meta property="og:url" content={~p"/"} />
    <meta property="og:image" content={~p"/images/logobg.png"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sokochat · Turn WhatsApp chats into orders" />
    <meta
      name="twitter:description"
      content="AI answers customers from your catalogue on WhatsApp, automatically or after you approve each reply. Orders and questions wait on your desk."
    />
    <meta name="twitter:image" content={~p"/images/logobg.png"} />
    <.live_title default="Sokochat" suffix=" · Sokochat">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href={~p"/fonts/OGARANYA-Regular.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="bg-soko-white font-sans text-soko-ink antialiased">
    {@inner_content}
  </body>
</html>
