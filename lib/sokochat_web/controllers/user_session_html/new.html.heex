<.auth_split
  label="Sign in"
  title="Log in to your shop"
  eyebrow="For businesses"
  headline="Answer buyers on WhatsApp and see every order on your desk."
>
  <:subtitle>Pick up the orders and questions that came in on WhatsApp.</:subtitle>

  <.form
    :let={f}
    for={@conn.params["user"]}
    as={:user}
    action={~p"/users/log_in"}
    class="soko-form !gap-5"
  >
    <.banner :if={@error_message} tone="danger">{@error_message}</.banner>

    <.input
      field={f[:email]}
      type="email"
      label="Email"
      size="lg"
      required
      autocomplete="email"
      placeholder="you@yourshop.co.ke"
    />
    <.input
      field={f[:password]}
      type="password"
      label="Password"
      size="lg"
      value=""
      required
      autocomplete="current-password"
    >
      <:trailing><.password_toggle for="user_password" /></:trailing>
    </.input>

    <div class="flex items-center justify-between gap-4">
      <.input field={f[:remember_me]} type="checkbox" label="Keep me logged in" />
      <.link href={~p"/users/reset_password"} class="soko-link text-sm">
        Forgot your password?
      </.link>
    </div>

    <.button size="lg" width="full" phx-disable-with="Logging in">
      <.icon name="arrow-right" /> Log in
    </.button>

    <p class="text-sm text-soko-ink-2">
      New to Sokochat?
      <.link navigate={~p"/users/register"} class="soko-link">Create an account</.link>
    </p>
  </.form>

  <:stage>
    <div class="absolute inset-0 overflow-hidden rounded-soko-20">
      <img
        src={~p"/images/people-phone.jpg"}
        alt="Two friends laughing while looking at a phone"
        class="h-full w-full object-cover object-[50%_30%]"
      />
    </div>
    <.order_note
      class="absolute left-4 top-4 hidden sm:block"
      photo={~p"/images/cherry-case.webp"}
      title="New order"
      meta="Cherry phone case"
      badge="Paid"
      foot_left="Order 1042"
      foot_right="KES 1,200"
    />
    <.stat_note
      class="absolute bottom-4 right-4 hidden sm:flex"
      label="Asked this week"
      value="14 people"
      caption="Phone cases"
    />
  </:stage>
</.auth_split>
