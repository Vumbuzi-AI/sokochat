<.auth_card
  icon="lock-simple"
  title="Forgot your password?"
  text="Enter the email you log in with and we'll send you a link to reset your password."
>
  <.simple_form
    :let={f}
    for={@conn.params["user"]}
    as={:user}
    action={~p"/users/reset_password"}
    class="!gap-5"
  >
    <.input
      field={f[:email]}
      type="email"
      label="Email"
      size="lg"
      placeholder="you@yourshop.co.ke"
      autocomplete="email"
      required
    />
    <.button size="lg" width="full" phx-disable-with="Sending">Send reset link</.button>
  </.simple_form>

  <:footer>
    <.link navigate={~p"/users/log_in"} class="soko-link">Log in</.link>
    <span class="px-1.5 text-soko-ink-3">or</span>
    <.link navigate={~p"/users/register"} class="soko-link">create an account</.link>
  </:footer>
</.auth_card>
