<.auth_card
  icon="key"
  title="Reset Password"
  text="Choose a new password for your shop. You'll use it the next time you log in."
>
  <.simple_form
    :let={f}
    for={@changeset}
    action={~p"/users/reset_password/#{@token}"}
    class="!gap-5"
  >
    <.banner :if={@changeset.action} tone="danger">
      Some details need another look. Check the fields below.
    </.banner>
    <.input
      field={f[:password]}
      type="password"
      label="New password"
      size="lg"
      autocomplete="new-password"
      hint="At least 6 characters."
      required
    >
      <:trailing><.password_toggle for="user_password" /></:trailing>
    </.input>
    <.input
      field={f[:password_confirmation]}
      type="password"
      label="Confirm new password"
      size="lg"
      autocomplete="new-password"
      required
    />
    <.button size="lg" width="full" phx-disable-with="Saving">Reset password</.button>
  </.simple_form>

  <:footer>
    <.link navigate={~p"/users/log_in"} class="soko-link">Log in</.link>
    <span class="px-1.5 text-soko-ink-3">or</span>
    <.link navigate={~p"/users/register"} class="soko-link">create an account</.link>
  </:footer>
</.auth_card>
