<SokochatWeb.WorkspaceShell.shell
  :if={@workspace}
  workspace={@workspace}
  workspaces={@workspaces}
  current_user={@current_user}
  tab={:settings}
  title="Account settings"
  subtitle="Appearance, email and password"
  flash={@flash}
>
  <.settings_body email_changeset={@email_changeset} password_changeset={@password_changeset} />
</SokochatWeb.WorkspaceShell.shell>

<div :if={!@workspace} class="min-h-dvh bg-soko-stage">
  <.flash_group flash={@flash} />
  <.site_header>
    <.button navigate={~p"/workspaces/new"} size="sm">Set up your shop</.button>
  </.site_header>
  <main class="mx-auto max-w-[960px] px-4 pb-8">
    <h1 class="soko-heading px-2 pb-4 pt-2 text-[24px]">Account settings</h1>
    <div class="soko-panel p-6">
      <.settings_body email_changeset={@email_changeset} password_changeset={@password_changeset} />
    </div>
  </main>
</div>
