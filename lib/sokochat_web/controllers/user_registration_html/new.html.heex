<.auth_split
  label="Create account"
  title="Set up your shop on Sokochat"
  eyebrow="How it works"
  headline="Sell what you stock to people who ask on WhatsApp."
>
  <:subtitle>
    Already have an account? <.link navigate={~p"/users/log_in"} class="soko-link">Log in</.link>
  </:subtitle>

  <.form :let={f} for={@form} action={~p"/users/register"} class="soko-form !gap-5">
    <.banner :if={@changeset.action == :insert} tone="danger">
      Some details need another look. Check the fields below.
    </.banner>

    <.input
      field={f[:name]}
      type="text"
      label="Name"
      size="lg"
      required
      autocomplete="name"
      placeholder="Mercy Wanjiku"
    />
    <.input
      field={f[:email]}
      type="email"
      label="Email"
      size="lg"
      required
      autocomplete="email"
      placeholder="you@yourshop.co.ke"
    />
    <.input
      field={f[:password]}
      type="password"
      label="Password"
      size="lg"
      required
      autocomplete="new-password"
      hint="At least 6 characters."
    >
      <:trailing><.password_toggle for="user_password" /></:trailing>
    </.input>

    <.button size="lg" width="full" phx-disable-with="Creating account">
      <.icon name="arrow-right" /> Create account
    </.button>

    <p class="text-xs text-soko-ink-3">We'll email you a link to confirm your account.</p>
  </.form>

  <:aside>
    <ol class="flex flex-col">
      <li
        :for={
          {n, title, text} <- [
            {"01", "Add your products and your website",
             "Names, photos and prices in KES. Sokochat reads your website too."},
            {"02", "Share one WhatsApp number",
             "Buyers ask there. Sokochat replies with what you have."},
            {"03", "Confirm orders on your desk",
             "Paid orders and questions wait for you in one place."}
          ]
        }
        class="flex gap-6 border-t border-soko-line-2 py-4 first:border-t-0"
      >
        <span class="font-mono text-xs text-soko-forest">{n}</span>
        <span class="flex flex-col gap-1">
          <span class="text-base font-medium">{title}</span>
          <span class="text-sm text-soko-ink-2">{text}</span>
        </span>
      </li>
    </ol>
  </:aside>

  <:stage>
    <div class="absolute inset-0 overflow-hidden rounded-soko-20">
      <img
        src={~p"/images/adidas-spezial.webp"}
        alt="A curved row of Adidas Spezial trainers in many colours"
        class="h-full w-full object-cover"
      />
    </div>
    <.sample_tag class="absolute left-4 top-4 !bg-soko-white" />
    <.stat_note
      class="absolute bottom-4 right-4 hidden sm:flex"
      label="Adidas Spezial"
      value="KES 6,500"
      caption="5 sizes · EU 38 to 42"
    />
  </:stage>
</.auth_split>
