<.auth_card
  icon="envelope-simple"
  title="No confirmation instructions received?"
  text="We'll send a new confirmation link to your inbox."
>
  <.simple_form
    :let={f}
    for={@conn.params["user"]}
    as={:user}
    action={~p"/users/confirm"}
    class="!gap-5"
  >
    <.banner>Check your spam folder first. The email comes from Sokochat.</.banner>
    <.input
      field={f[:email]}
      type="email"
      label="Email"
      size="lg"
      placeholder="you@yourshop.co.ke"
      autocomplete="email"
      required
    />
    <.button size="lg" width="full" phx-disable-with="Sending">Resend confirmation link</.button>
  </.simple_form>

  <:footer>
    <.link navigate={~p"/users/log_in"} class="soko-link">Log in</.link>
    <span class="px-1.5 text-soko-ink-3">or</span>
    <.link navigate={~p"/users/register"} class="soko-link">create an account</.link>
  </:footer>
</.auth_card>
