<.auth_card
  icon="seal-check"
  title="Confirm account"
  text="One more step. Confirm your account to start setting up your shop."
>
  <.simple_form for={@conn.params["user"]} as={:user} action={~p"/users/confirm/#{@token}"}>
    <.button size="lg" width="full" phx-disable-with="Confirming">Confirm my account</.button>
  </.simple_form>

  <:footer>
    <.link navigate={~p"/users/log_in"} class="soko-link">Log in</.link>
    <span class="px-1.5 text-soko-ink-3">or</span>
    <.link navigate={~p"/users/register"} class="soko-link">create an account</.link>
  </:footer>
</.auth_card>
